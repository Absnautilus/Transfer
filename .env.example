# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string used by the app at runtime. For local dev you
# can run a local Postgres, or point this at a free Neon/Vercel/Supabase
# Postgres database (see README).
DATABASE_URL="postgresql://user:password@host:5432/hotel_transfer"

# Only needed with Supabase: its pooled connection (port 6543, used above)
# can't run migrations. Set DIRECT_URL to Supabase's direct connection
# (port 5432) and `prisma migrate` will use it automatically. Leave unset
# for Neon/Vercel Postgres/local Postgres — DATABASE_URL alone is enough.
# DIRECT_URL="postgresql://user:password@host:5432/hotel_transfer"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Used to build links in outgoing emails (guest tracking page, etc.)
APP_URL="http://localhost:3000"

# Optional. Guests land directly on this hotel's questionnaire from the
# homepage (single-hotel pilot). If unset, the first hotel created is used.
# Only matters when more than one hotel exists in the database.
# PRIMARY_HOTEL_SLUG="hotel-palazzo-veneziano"

# SMTP is optional in development: without it, outgoing emails are logged
# to the console and to the EmailLog table instead of actually being sent.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Hotel Transfer <no-reply@example.com>"
