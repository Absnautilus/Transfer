// Prisma schema — Hotel Transfer Automation
// status/role fields are plain Strings constrained by the shared constants
// in src/lib/constants.ts (kept as strings rather than native enums so the
// same schema could still target a non-Postgres database if ever needed).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organizations
// ---------------------------------------------------------------------------

model Hotel {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // used in the public questionnaire URL
  address   String?
  email     String? // receives copies of notifications
  phone     String?
  createdAt DateTime @default(now())

  primaryTaxiCompanyId String?
  primaryTaxiCompany   TaxiCompany? @relation(fields: [primaryTaxiCompanyId], references: [id], onDelete: SetNull)

  users    User[]
  routes   HotelRoute[]
  requests TransferRequest[]
  transfers Transfer[]
}

model TaxiCompany {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  // Percentage taken as commission on each transfer's price, e.g. 15 = 15%.
  // Nullable: not every company has one configured yet.
  commissionRate Float?

  users     User[]
  drivers   Driver[]
  transfers Transfer[]
  hotelsUsingAsPrimary Hotel[]
}

// One row = one way to reach a given point from the hotel (or vice versa).
// A point (e.g. "Aeroporto Marco Polo") can have several rows, one per
// transferMode, each with its own description/duration/price — e.g. private
// water taxi vs. car vs. car + water taxi for the same airport.
//
// priceTiers shape: { "day": { "1-4": 95, "5": 105, "6": 110, "7": 115, "8": 120 },
//                      "night": { "1-4": 105, "5": 115, "6": 120, "7": 125, "8": 130 } }
// Pax counts above the highest band use that band's price.
// pointCategory: AEROPORTO | STAZIONE | PORTO | ALTRO — used to group/icon the
// guest-facing point picker.
model HotelRoute {
  id              String  @id @default(cuid())
  hotelId         String
  hotel           Hotel   @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  pointLabel      String // e.g. "Aeroporto Marco Polo (VCE)" — internal/fallback label
  pointCategory   String  @default("ALTRO")
  transferMode    String? // e.g. "Auto privata" — null when the point has only one mode
  // Per-locale text, shape { it, en, es, pt, fr, de } — all keys optional
  // except "it" which is the required fallback. Split by direction because the
  // meeting instructions differ (e.g. "we wait at arrivals" vs "pickup at the hotel lobby").
  descriptionArrival   Json?
  descriptionDeparture Json?
  durationMinutes Int?
  priceTiers      Json // see comment above
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  requests  TransferRequest[]
  transfers Transfer[]

  @@index([hotelId])
}

// ---------------------------------------------------------------------------
// Users & drivers
// ---------------------------------------------------------------------------

// role: HOTEL_STAFF | TAXI_STAFF | DRIVER | ADMIN
//
// isOrgAdmin: this user is the administrator of their Hotel/TaxiCompany —
// can see accounting and grant permissions to other staff/drivers in the
// same org. permissions: extra granular grants on top of the base role
// (see src/lib/permissions.ts for the list of keys), for staff who aren't
// full org admins but need one extra capability (e.g. VIEW_ACCOUNTING).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String
  phone        String?
  isOrgAdmin   Boolean  @default(false)
  permissions  Json     @default("[]")
  createdAt    DateTime @default(now())

  hotelId       String?
  hotel         Hotel?       @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  taxiCompanyId String?
  taxiCompany   TaxiCompany? @relation(fields: [taxiCompanyId], references: [id], onDelete: SetNull)
  driverId      String?      @unique
  driver        Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)

  reviewedRequests TransferRequest[] @relation("RequestReviewedBy")
  createdTransfers  Transfer[]       @relation("TransferCreatedBy")
  updatedTransfers  Transfer[]       @relation("TransferUpdatedBy")
  cancelledTransfers Transfer[]      @relation("TransferCancelledBy")
  notifications      Notification[]

  @@index([hotelId])
  @@index([taxiCompanyId])
}

model Driver {
  id            String      @id @default(cuid())
  taxiCompanyId String
  taxiCompany   TaxiCompany @relation(fields: [taxiCompanyId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  vehicleInfo   String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  account   User?
  transfers Transfer[]

  @@index([taxiCompanyId])
}

// ---------------------------------------------------------------------------
// Requests (guest questionnaire submissions, pending hotel review)
// ---------------------------------------------------------------------------

// status: PENDING | ACCEPTED | REJECTED
model TransferRequest {
  id       String @id @default(cuid())
  hotelId  String
  hotel    Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  status   String @default("PENDING")

  // Guest-provided info
  guestFirstName String
  guestLastName  String
  guestEmail     String
  guestPhone     String
  roomNumber     String?
  bookingNumber  String?
  pax            Int
  bagsCabin      Int     @default(0)
  bagsStandard   Int     @default(0)
  bagsLarge      Int     @default(0)
  date           String // YYYY-MM-DD
  time           String // HH:mm
  isNightService Boolean @default(false)
  routeOptionId  String?
  routeOption    HotelRoute? @relation(fields: [routeOptionId], references: [id], onDelete: SetNull)
  routeFrom      String
  routeTo        String
  quotedPrice    Float?
  // How the guest reaches the meeting point when direction is ARRIVO:
  // AUTO | AUTOBUS | TRENO | AEREO | NAVE. Null for PARTENZA requests.
  arrivalMode         String?
  estimatedArrivalTime String? // HH:mm, only meaningful for AUTO/AUTOBUS
  flightOrTrainNumber String? // also used for ship name when arrivalMode = NAVE
  flightOrTrainOrigin String?
  notes          String?
  // Guest's chosen language for the questionnaire/emails: it | en | es | pt | fr | de
  locale String @default("it")

  // Review outcome
  reviewedAt       DateTime?
  reviewedByUserId String?
  reviewedByUser   User?    @relation("RequestReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  rejectionReason  String?

  transfer  Transfer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId, status])
  @@index([hotelId, date])
}

// ---------------------------------------------------------------------------
// Confirmed transfers (shared hotel <-> taxi company table)
// ---------------------------------------------------------------------------

// status: AWAITING_TAXI | CONFIRMED | REJECTED_BY_TAXI | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
model Transfer {
  id            String       @id @default(cuid())
  hotelId       String
  hotel         Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  taxiCompanyId String?
  taxiCompany   TaxiCompany? @relation(fields: [taxiCompanyId], references: [id], onDelete: SetNull)

  requestId String?          @unique
  request   TransferRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  status String @default("AWAITING_TAXI")

  guestFirstName String
  guestLastName  String
  guestEmail     String?
  guestPhone     String?
  roomNumber     String?
  bookingNumber  String?
  pax            Int
  bags           String? // legacy free-text summary, kept for CSV imports; see bagsCabin/Standard/Large
  bagsCabin      Int     @default(0)
  bagsStandard   Int     @default(0)
  bagsLarge      Int     @default(0)
  date           String // YYYY-MM-DD
  time           String // HH:mm
  isNightService Boolean @default(false)
  routeOptionId  String?
  routeOption    HotelRoute? @relation(fields: [routeOptionId], references: [id], onDelete: SetNull)
  routeFrom      String
  routeTo        String
  arrivalMode          String?
  estimatedArrivalTime String?
  flightOrTrainNumber String?
  flightOrTrainOrigin String?
  notes          String?
  price          Float?
  // priceAdjustmentType: DISCOUNT | SURCHARGE — applied on top of price for
  // the final amount owed; priceAdjustmentAmount is always a positive number.
  priceAdjustmentType   String?
  priceAdjustmentAmount Float?
  operatorInitials String?
  locale String @default("it")

  // Commission owed to the taxi company on this transfer, snapshotted from
  // TaxiCompany.commissionRate at confirmation time so later rate changes
  // don't rewrite past accounting.
  commissionRateSnapshot Float?

  taxiRejectionReason String?

  // Cancellation — penaltyType: NONE | FULL | PARTIAL. penaltyAmount is only
  // set when penaltyType = PARTIAL (the guest-owed amount).
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancelledByUser     User?     @relation("TransferCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancellationReason  String?
  penaltyType         String?
  penaltyAmount       Float?

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  guestTrackingToken String  @unique @default(cuid())
  tripStartedAt       DateTime?
  tripCompletedAt      DateTime?

  createdByUserId String?
  createdByUser   User?   @relation("TransferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String?
  updatedByUser   User?   @relation("TransferUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  statusEvents TripStatusEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId, date])
  @@index([taxiCompanyId, date])
  @@index([driverId])
  @@index([bookingNumber])
  @@index([guestLastName])
}

// status snapshots for the driver/guest shared trip screen
model TripStatusEvent {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  status     String // ASSIGNED | EN_ROUTE | ARRIVED | STARTED | COMPLETED
  note       String?
  createdAt  DateTime @default(now())

  @@index([transferId])
}

// In-app notification for a staff/driver user. type is a short machine key
// (e.g. "REQUEST_NEW", "REQUEST_ACCEPTED", "TRANSFER_CONFIRMED",
// "TRANSFER_CANCELLED") used for icon/routing; link is an in-app path to
// open when clicked.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  status    String   @default("SENT") // SENT | FAILED
  error     String?
  createdAt DateTime @default(now())
}
